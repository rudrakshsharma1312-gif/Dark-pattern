{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:web": "vite build",
    "preview:web": "vite preview --outDir dist-web",
    "build:extension": "node scripts/build-extension.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "verify:extension": "node scripts/verify-extension.mjs",
    "release:extension": "node scripts/package-extension.mjs && git add extension-dist downloads/darkguard-extension.zip",
    "dev:ext": "node scripts/package-extension.mjs && node -e \"console.log('\\n✅ Extension packaged in extension-dist/!\\nTo see updates in Chrome:\\n1. Go to chrome://extensions\\n2. Click the ↺ (Reload) button on DarkGuard AI\\n3. Close and reopen the popup.\\n')\"",
    "serve:site": "tsx scripts/serve-site.ts",
    "verify:pages": "tsx scripts/verify-all-pages.ts",
    "verify:links": "tsx scripts/verify-pages-links.ts",
    "eval:real": "tsx eval/run.ts --real-engine",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/smoke.ts",
    "start": "tsx server.ts",
    "preview": "vite preview --outDir dist-web",
    "clean": "rm -rf dist dist-web server.js _site",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
